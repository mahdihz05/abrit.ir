# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,abrit.cloud
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://abrit.cloud
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://abrit.cloud
DJANGO_SCRIPT_NAME=/cms
DJANGO_DATABASE_PATH=backend/data/abrit.sqlite3
DJANGO_PUBLIC_MEDIA_ROOT=backend/media
DJANGO_PRIVATE_MEDIA_ROOT=backend/private-media
NEXT_REVALIDATION_URL=https://abrit.cloud/api/revalidate
NEXT_REVALIDATION_SECRET=replace-with-a-separate-random-secret

# Next.js
NEXT_PUBLIC_SITE_URL=https://abrit.cloud
NEXT_PUBLIC_API_URL=https://abrit.cloud/cms/api/v1
BACKEND_API_URL=https://abrit.cloud/cms/api/v1
REVALIDATION_SECRET=replace-with-the-same-revalidation-secret
