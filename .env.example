# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cms.abrit.ir
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://abrit.ir,https://www.abrit.ir,https://cms.abrit.ir
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://abrit.ir,https://www.abrit.ir
DJANGO_DATABASE_PATH=backend/data/abrit.sqlite3
DJANGO_PUBLIC_MEDIA_ROOT=backend/media
DJANGO_PRIVATE_MEDIA_ROOT=backend/private-media
NEXT_REVALIDATION_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATION_SECRET=replace-with-a-separate-random-secret

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_API_URL=http://localhost:8000/api/v1
REVALIDATION_SECRET=replace-with-the-same-revalidation-secret
